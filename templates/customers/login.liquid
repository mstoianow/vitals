<div class="section">
  <div class="page-width customer">
    <h1 class="h1 customer__title">{{ 'customer.login.title' | t }}</h1>

    {%- form 'customer_login', class: 'customer__form' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
        <input
          type="email"
          id="CustomerEmail"
          name="customer[email]"
          class="field__input"
          autocomplete="email"
          required
        >
      </div>

      <div class="field">
        <label class="field__label" for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
        <input
          type="password"
          id="CustomerPassword"
          name="customer[password]"
          class="field__input"
          autocomplete="current-password"
          required
        >
      </div>

      <button type="submit" class="button button--primary button--full">
        {{- 'customer.login.submit' | t -}}
      </button>
    {%- endform -%}

    <details class="customer__recover">
      <summary class="button button--link">{{ 'customer.login.forgot_password' | t }}</summary>

      {%- form 'recover_customer_password', class: 'customer__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success">{{ 'customer.recover_password.success' | t }}</p>
        {%- else -%}
          <p class="text-small text-muted">{{ 'customer.recover_password.subtext' | t }}</p>

          <div class="field">
            <label class="field__label" for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
            <input
              type="email"
              id="RecoverEmail"
              name="email"
              class="field__input"
              autocomplete="email"
              required
            >
          </div>

          <button type="submit" class="button button--secondary">
            {{- 'customer.recover_password.submit' | t -}}
          </button>
        {%- endif -%}
      {%- endform -%}
    </details>

    <div class="customer__footer">
      <p class="text-small text-muted">{{ 'customer.login.no_account' | t }}</p>
      <a href="{{ routes.account_register_url }}" class="button button--secondary">
        {{- 'customer.login.create_account' | t -}}
      </a>
    </div>
  </div>
</div>
