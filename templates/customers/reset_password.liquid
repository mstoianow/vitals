<div class="section">
  <div class="page-width customer">
    <h1 class="h1 customer__title">{{ 'customer.reset_password.title' | t }}</h1>

    {%- form 'reset_customer_password', class: 'customer__form' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input
          type="password"
          id="ResetPassword"
          name="customer[password]"
          class="field__input"
          autocomplete="new-password"
          required
        >
      </div>

      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">
          {{- 'customer.reset_password.password_confirm' | t -}}
        </label>
        <input
          type="password"
          id="ResetPasswordConfirm"
          name="customer[password_confirmation]"
          class="field__input"
          autocomplete="new-password"
          required
        >
      </div>

      <button type="submit" class="button button--primary button--full">
        {{- 'customer.reset_password.submit' | t -}}
      </button>
    {%- endform -%}
  </div>
</div>
