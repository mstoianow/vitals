{%- liquid
  assign menu = section.settings.menu
  assign header_classes = 'header color-' | append: section.settings.color_scheme
  if section.settings.sticky
    assign header_classes = header_classes | append: ' header--sticky'
  endif
  if section.settings.show_border
    assign header_classes = header_classes | append: ' header--bordered'
  endif
-%}

<header
  class="{{ header_classes }}"
  style="--logo-width: {{ section.settings.logo_width }}px; --header-padding: {{ section.settings.padding_block }}px;"
>
  <div class="page-width header__inner">
    <details class="header__drawer">
      <summary class="header__icon-button" aria-label="{{ 'accessibility.open_menu' | t }}">
        <span class="header__icon-open">{% render 'icon', name: 'menu', size: 22 %}</span>
        <span class="header__icon-close">{% render 'icon', name: 'close', size: 22 %}</span>
      </summary>

      <div class="header__drawer-panel">
        <nav class="header__drawer-nav" aria-label="{{ 'accessibility.menu' | t }}">
          {%- for link in menu.links -%}
            {%- if link.links.size > 0 -%}
              <details class="header__drawer-group">
                <summary class="header__drawer-link">
                  {{ link.title }}
                  {% render 'icon', name: 'chevron-down', size: 18 %}
                </summary>
                <ul class="header__drawer-sublist">
                  {%- for child in link.links -%}
                    <li>
                      <a href="{{ child.url }}" class="header__drawer-sublink">{{ child.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="header__drawer-link">{{ link.title }}</a>
            {%- endif -%}
          {%- endfor -%}

          {%- if shop.customer_accounts_enabled -%}
            <a href="{{ routes.account_url }}" class="header__drawer-link">
              {%- if customer -%}
                {{ customer.first_name | default: 'Account' }}
              {%- else -%}
                Log in
              {%- endif -%}
            </a>
          {%- endif -%}
        </nav>
      </div>
    </details>

    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo">
    {%- else -%}
      <div class="header__logo">
    {%- endif -%}
    <a href="{{ routes.root_url }}" class="header__logo-link">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag: loading: 'eager', widths: '130, 260, 390, 520, 600', alt: shop.name
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- else -%}
      </div>
    {%- endif -%}

    <nav class="header__nav" aria-label="{{ 'accessibility.menu' | t }}">
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <details class="header__nav-item">
            <summary class="header__nav-link">
              {{ link.title }}
              {% render 'icon', name: 'chevron-down', size: 15 %}
            </summary>
            <ul class="header__dropdown">
              {%- for child in link.links -%}
                <li>
                  <a href="{{ child.url }}" class="header__dropdown-link">{{ child.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </details>
        {%- else -%}
          <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="header__actions">
      {%- if section.settings.show_search -%}
        <details class="header__search">
          <summary class="header__icon-button" aria-label="{{ 'general.search.title' | t }}">
            <span class="header__icon-open">{% render 'icon', name: 'search', size: 21 %}</span>
            <span class="header__icon-close">{% render 'icon', name: 'close', size: 21 %}</span>
          </summary>
          <div class="header__search-panel">
            <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form">
              <label class="visually-hidden" for="HeaderSearch">{{ 'general.search.title' | t }}</label>
              <input
                type="search"
                id="HeaderSearch"
                name="q"
                class="field__input"
                placeholder="{{ 'general.search.placeholder' | t }}"
                autocomplete="off"
              >
              <button type="submit" class="button button--primary">{{ 'general.search.submit' | t }}</button>
            </form>
          </div>
        </details>
      {%- endif -%}

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a
          href="{{ routes.account_url }}"
          class="header__icon-button header__account"
          aria-label="{{ 'accessibility.menu' | t }}"
        >
          {% render 'icon', name: 'user', size: 21 %}
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header__icon-button header__cart" aria-label="{{ 'accessibility.open_cart' | t }}">
        {% render 'icon', name: 'cart', size: 21 %}
        {%- if cart.item_count > 0 -%}
          <span class="header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ 'accessibility.cart_count' | t: count: cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    position: relative;
    z-index: 10;
    background: var(--color-background-gradient);
    color: rgb(var(--color-text));
  }

  .header--sticky {
    position: sticky;
    top: 0;
  }

  .header--bordered {
    border-bottom: 1px solid rgb(var(--color-border));
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: var(--header-padding, 16px);
  }

  .header__icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .header__icon-button:hover {
    background-color: rgb(var(--color-text) / 0.07);
  }

  .header__icon-close {
    display: none;
  }

  details[open] > .header__icon-button > .header__icon-open {
    display: none;
  }

  details[open] > .header__icon-button > .header__icon-close {
    display: inline-flex;
  }

  /* Logo */
  .header__logo {
    grid-column: 2;
    margin: 0;
    font-size: 1.125rem;
    text-align: center;
  }

  .header__logo-link {
    display: inline-block;
    text-decoration: none;
  }

  .header__logo-link img {
    width: var(--logo-width, 130px);
    height: auto;
  }

  .header__logo-text {
    font-family: var(--font-heading-family);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Desktop navigation */
  .header__nav {
    display: none;
    grid-column: 1;
    grid-row: 1;
    align-items: center;
    gap: 0.25rem;
  }

  .header__nav-item {
    position: relative;
  }

  .header__nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-input);
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__nav-link:hover {
    background-color: rgb(var(--color-text) / 0.06);
  }

  .header__dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 13rem;
    padding: 0.5rem;
    background: var(--color-background-gradient);
    border: 1px solid rgb(var(--color-border));
    border-radius: var(--radius-card);
    box-shadow: 0 12px 32px rgb(var(--color-shadow) / 0.1);
  }

  .header__dropdown-link {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: calc(var(--radius-input) * 0.75);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .header__dropdown-link:hover {
    background-color: rgb(var(--color-text) / 0.06);
  }

  /* Actions */
  .header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    grid-column: 3;
  }

  .header__account {
    display: none;
  }

  .header__cart-count {
    position: absolute;
    top: 0.35rem;
    right: 0.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding-inline: 0.25rem;
    background-color: rgb(var(--color-accent));
    color: rgb(var(--color-background));
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
  }

  /* Search panel */
  .header__search {
    position: static;
  }

  .header__search-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 1.25rem;
    background: var(--color-background-gradient);
    border-top: 1px solid rgb(var(--color-border));
    border-bottom: 1px solid rgb(var(--color-border));
    box-shadow: 0 12px 32px rgb(var(--color-shadow) / 0.08);
  }

  .header__search-form {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  /* Mobile drawer */
  .header__drawer {
    grid-column: 1;
    justify-self: start;
  }

  .header__drawer-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: 75vh;
    overflow-y: auto;
    padding: 1rem 1.25rem 2rem;
    background: var(--color-background-gradient);
    border-top: 1px solid rgb(var(--color-border));
    box-shadow: 0 16px 32px rgb(var(--color-shadow) / 0.1);
  }

  .header__drawer-nav {
    display: flex;
    flex-direction: column;
  }

  .header__drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgb(var(--color-border));
    font-size: 1.0625rem;
    text-decoration: none;
  }

  .header__drawer-sublist {
    padding: 0.25rem 0 0.75rem 0.75rem;
  }

  .header__drawer-sublink {
    display: block;
    padding: 0.55rem 0;
    text-decoration: none;
    opacity: 0.78;
  }

  .header__drawer-group[open] > .header__drawer-link .icon--chevron-down {
    rotate: 180deg;
  }

  @media screen and (min-width: 990px) {
    .header__drawer {
      display: none;
    }

    .header__nav {
      display: flex;
    }

    .header__logo {
      text-align: center;
    }

    .header__account {
      display: inline-flex;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "shopify-section--header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 260,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 130
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to top when scrolling",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 16
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
