<div class="section color-{{ section.settings.color_scheme }}" style="--section-padding-block: {{ section.settings.padding_block }}px;">
  <div class="page-width">
    <div class="faq">
      <div class="faq__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- assign faq_title = 'sections.faq.title' | t -%}
        <h2 class="h2">{{ section.settings.heading | default: faq_title }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte text-muted">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="faq__list">
        {%- for block in section.blocks -%}
          <details class="accordion" {{ block.shopify_attributes }}>
            <summary class="accordion__summary">
              {{ block.settings.question }}
              {% render 'icon', name: 'chevron-down', size: 20 %}
            </summary>
            <div class="accordion__content rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .faq {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  .faq__header {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  @media screen and (min-width: 990px) {
    .faq {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 4rem;
    }

    .faq__header {
      position: sticky;
      top: 6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Често задавани въпроси"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Кога да приемам продукта?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Приемайте по две капсули дневно с храна. Редовността е по-важна от точния час, затова изберете момент, който лесно ще запомните.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Кога да приемам продукта?",
            "answer": "<p>Приемайте по две капсули дневно с храна. Редовността е по-важна от точния час, затова изберете момент, който лесно ще запомните.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Как да разчета резултатите от тестовете?",
            "answer": "<p>Всяка партида има сертификат за анализ, достъпен от страницата на продукта. В него е посочено измереното количество на всяко активно вещество, заедно с резултатите от изследванията за тежки метали и микробиологичен контрол.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Мога ли да комбинирам няколко продукта?",
            "answer": "<p>Да. Продуктите са създадени така, че да се комбинират без припокриване на дозите. Ако приемате лекарства с рецепта, първо се консултирайте с вашия лекар или фармацевт.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Каква е политиката ви за връщане?",
            "answer": "<p>Ако продуктът не е подходящ за вас, свържете се с нас в рамките на 30 дни за пълно възстановяване на сумата – независимо дали опаковката е отворена.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
