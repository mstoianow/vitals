<footer class="footer color-{{ section.settings.color_scheme }}">
  <div class="page-width footer__inner">
    <div class="footer__blocks">
      {%- for block in section.blocks -%}
        <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              {%- if block.settings.logo != blank -%}
                <div class="footer__logo" style="--footer-logo-width: {{ block.settings.logo_width }}px;">
                  {{ block.settings.logo | image_url: width: 500 | image_tag: loading: 'lazy', alt: shop.name }}
                </div>
              {%- else -%}
                <p class="footer__brand-name">{{ block.settings.brand_text | default: shop.name | escape }}</p>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="rte text-muted">{{ block.settings.text }}</div>
              {%- endif -%}

              <ul class="footer__social">
                {%- if settings.social_instagram_link != blank -%}
                  <li>
                    <a href="{{ settings.social_instagram_link }}" class="footer__social-link">
                      {% render 'icon', name: 'instagram' %}
                      <span class="visually-hidden">{{ 'general.social.instagram' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_tiktok_link != blank -%}
                  <li>
                    <a href="{{ settings.social_tiktok_link }}" class="footer__social-link">
                      {% render 'icon', name: 'tiktok' %}
                      <span class="visually-hidden">{{ 'general.social.tiktok' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_facebook_link != blank -%}
                  <li>
                    <a href="{{ settings.social_facebook_link }}" class="footer__social-link">
                      {% render 'icon', name: 'facebook' %}
                      <span class="visually-hidden">{{ 'general.social.facebook' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_youtube_link != blank -%}
                  <li>
                    <a href="{{ settings.social_youtube_link }}" class="footer__social-link">
                      {% render 'icon', name: 'youtube' %}
                      <span class="visually-hidden">{{ 'general.social.youtube' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>

            {%- when 'menu' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="footer__link">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>

            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte text-muted footer__newsletter-text">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- form 'customer', class: 'footer__newsletter' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="FooterNewsletter">
                  {{- 'general.newsletter.label' | t -}}
                </label>
                <div class="footer__newsletter-row">
                  <input
                    type="email"
                    id="FooterNewsletter"
                    name="contact[email]"
                    class="field__input"
                    placeholder="{{ 'general.newsletter.placeholder' | t }}"
                    autocomplete="email"
                    required
                  >
                  <button type="submit" class="button button--primary">
                    {{- 'general.newsletter.submit' | t -}}
                  </button>
                </div>

                {%- if form.errors -%}
                  <p class="form__message form__message--error">
                    {{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}
                  </p>
                {%- elsif form.posted_successfully? -%}
                  <p class="form__message form__message--success">
                    {{ 'general.newsletter.success' | t }}
                  </p>
                {%- endif -%}
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright text-small text-muted">
        {%- assign current_year = 'now' | date: '%Y' -%}
        {{ 'sections.footer.copyright' | t: year: current_year, shop: shop.name }} {{ powered_by_link }}
      </p>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payment">
          <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
          <ul class="footer__payment-list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    background: var(--color-background-gradient);
    color: rgb(var(--color-text));
  }

  .footer {
    border-top: 1px solid rgb(var(--color-border));
  }

  .footer__inner {
    padding-block: 5rem 2rem;
  }

  .footer__blocks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .footer__block--brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 34ch;
  }

  .footer__logo img {
    width: var(--footer-logo-width, 150px);
    height: auto;
  }

  .footer__brand-name {
    display: inline-block;
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer__brand-name::first-letter {
    font-size: 1.3em;
  }

  .footer__heading {
    margin-bottom: 1.25rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer__link {
    text-decoration: none;
    opacity: 0.78;
    transition: opacity 0.15s ease;
  }

  .footer__link:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .footer__social {
    display: flex;
    gap: 0.5rem;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: 50%;
    transition: background-color 0.15s ease;
  }

  .footer__social-link:hover {
    background-color: rgb(var(--color-text) / 0.08);
  }

  .footer__newsletter-text {
    margin-bottom: 1rem;
  }

  .footer__newsletter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer__newsletter-row .field__input {
    flex: 1 1 12rem;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(var(--color-border));
  }

  .footer__copyright {
    margin: 0;
  }

  .footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .footer__payment-icon {
    width: 38px;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .footer__blocks {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 3rem 2rem;
    }

    .footer__block--brand,
    .footer__block--newsletter {
      grid-column: span 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "brand_text",
          "label": "Wordmark text",
          "default": "Verdvna"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 80,
          "max": 260,
          "step": 10,
          "unit": "px",
          "label": "Logo width",
          "default": 150
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Хранителни добавки, тествани от независима лаборатория, с клинично проучени дози и без нищо излишно.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Магазин"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Абонирайте се за бюлетина"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Резюмета на изследвания, известия за наличност и цени само за абонати. Без излишен шум.</p>"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "brand"
        },
        {
          "type": "menu"
        },
        {
          "type": "newsletter"
        }
      ]
    }
  ]
}
{% endschema %}
