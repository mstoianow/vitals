{% stylesheet %}
  .product {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .product__media {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .product__media-main {
    position: relative;
  }

  .product__media-item {
    display: none;
    width: 100%;
    height: 100%;
  }

  .product__media-item.is-active {
    display: block;
  }

  .product__thumbnails {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
    gap: 0.5rem;
  }

  .product__thumbnail {
    padding: 0;
    border: 1px solid transparent;
    cursor: pointer;
    transition: border-color 0.15s ease, opacity 0.15s ease;
    opacity: 0.7;
  }

  .product__thumbnail:hover {
    opacity: 1;
  }

  .product__thumbnail.is-active {
    border-color: rgb(var(--color-text));
    opacity: 1;
  }

  .product__details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-self: start;
  }

  .product__title {
    margin: 0;
  }

  .product__description {
    padding-top: 0.5rem;
  }

  /* Variant options */
  .variant-option {
    margin: 0;
    padding: 0;
    border: none;
  }

  .variant-option__legend {
    display: flex;
    gap: 0.35rem;
    margin-bottom: 0.6rem;
    padding: 0;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .variant-option__selected {
    font-weight: 400;
    opacity: 0.7;
  }

  .variant-option__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .variant-option__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: var(--radius-button);
    cursor: pointer;
    font-size: 0.9rem;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .variant-option__label:hover {
    border-color: rgb(var(--color-text) / 0.5);
  }

  .variant-option__input:checked + .variant-option__label {
    background-color: rgb(var(--color-text));
    color: rgb(var(--color-background));
    border-color: rgb(var(--color-text));
  }

  .variant-option__input:focus-visible + .variant-option__label {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  .variant-option__label.is-unavailable {
    opacity: 0.4;
    text-decoration: line-through;
  }

  /* Buy */
  .product-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .product__quantity {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 8rem;
  }

  .product__quantity-input {
    text-align: center;
  }

  .product__trust {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 0.5rem;
    font-size: 0.9rem;
  }

  .product__trust li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .product__trust .icon {
    flex-shrink: 0;
  }

  @media screen and (min-width: 990px) {
    .product {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .product__media {
      position: sticky;
      top: 6rem;
    }

    .product__trust {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% javascript %}
  class VariantPicker {
    constructor(root) {
      this.root = root;
      this.priceContainer = root.querySelector('[data-price-container]');
      this.variantInput = root.querySelector('[data-variant-id]');
      this.addButton = root.querySelector('[data-add-button]');
      this.addButtonText = root.querySelector('[data-add-button-text]');
      const container = root.closest('.product');
      this.gallery = container ? container.querySelector('[data-product-gallery]') : null;

      const dataElement = root.querySelector('[data-variant-json]');
      if (!dataElement) return;

      try {
        this.variants = JSON.parse(dataElement.textContent);
      } catch (error) {
        return;
      }

      this.inputs = Array.from(root.querySelectorAll('[data-option-input]'));
      if (this.inputs.length === 0) return;

      this.currency = root.dataset.currency || 'EUR';
      this.locale = document.documentElement.lang || 'en';

      this.inputs.forEach((input) => {
        input.addEventListener('change', () => this.onChange());
      });

      this.updateAvailability();
    }

    get selectedOptions() {
      const fieldsets = Array.from(this.root.querySelectorAll('[data-option-index]'));
      return fieldsets.map((fieldset) => {
        const checked = fieldset.querySelector('[data-option-input]:checked');
        return checked ? checked.value : null;
      });
    }

    findVariant(options) {
      return this.variants.find((variant) =>
        options.every((value, index) => value === null || variant.options[index] === value)
      );
    }

    formatMoney(cents) {
      try {
        return new Intl.NumberFormat(this.locale, {
          style: 'currency',
          currency: this.currency,
        }).format(cents / 100);
      } catch (error) {
        return (cents / 100).toFixed(2);
      }
    }

    onChange() {
      const options = this.selectedOptions;
      const variant = this.findVariant(options);

      this.root.querySelectorAll('[data-option-index]').forEach((fieldset, index) => {
        const label = fieldset.querySelector('[data-option-selected]');
        if (label && options[index]) label.textContent = options[index];
      });

      if (!variant) {
        this.setUnavailable();
        return;
      }

      if (this.variantInput) this.variantInput.value = variant.id;

      if (this.priceContainer) {
        let html = '<span>' + this.formatMoney(variant.price) + '</span>';
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          html += '<s class="price__compare">' + this.formatMoney(variant.compare_at_price) + '</s>';
        }
        const price = this.priceContainer.querySelector('.price');
        if (price) price.innerHTML = html;
      }

      if (this.addButton && this.addButtonText) {
        this.addButton.disabled = !variant.available;
        this.addButtonText.textContent = variant.available
          ? this.addButton.dataset.addLabel || 'Add to cart'
          : this.addButton.dataset.soldOutLabel || 'Sold out';
      }

      if (variant.featured_media && this.gallery) {
        this.showMedia(String(variant.featured_media.id));
      }

      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url.toString());

      this.updateAvailability();
    }

    showMedia(mediaId) {
      this.gallery.querySelectorAll('[data-media-id]').forEach((item) => {
        item.classList.toggle('is-active', item.dataset.mediaId === mediaId);
      });
      this.gallery.querySelectorAll('[data-thumbnail-for]').forEach((thumb) => {
        thumb.classList.toggle('is-active', thumb.dataset.thumbnailFor === mediaId);
      });
    }

    setUnavailable() {
      if (!this.addButton || !this.addButtonText) return;
      this.addButton.disabled = true;
      this.addButtonText.textContent = this.addButton.dataset.unavailableLabel || 'Unavailable';
    }

    updateAvailability() {
      const options = this.selectedOptions;
      this.root.querySelectorAll('[data-option-index]').forEach((fieldset, index) => {
        fieldset.querySelectorAll('[data-option-input]').forEach((input) => {
          const candidate = options.slice();
          candidate[index] = input.value;
          const match = this.variants.find((variant) =>
            candidate.every((value, i) => value === null || variant.options[i] === value)
          );
          const label = fieldset.querySelector('label[for="' + input.id + '"]');
          if (label) label.classList.toggle('is-unavailable', !match || !match.available);
        });
      });
    }
  }

  class ProductGallery {
    constructor(root) {
      this.root = root;
      root.querySelectorAll('[data-thumbnail-for]').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const id = thumb.dataset.thumbnailFor;
          root.querySelectorAll('[data-media-id]').forEach((item) => {
            item.classList.toggle('is-active', item.dataset.mediaId === id);
          });
          root.querySelectorAll('[data-thumbnail-for]').forEach((other) => {
            other.classList.toggle('is-active', other === thumb);
          });
        });
      });
    }
  }

  function initProductSection() {
    document.querySelectorAll('[data-product-gallery]').forEach((gallery) => new ProductGallery(gallery));
    document.querySelectorAll('[data-variant-root]').forEach((root) => new VariantPicker(root));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductSection);
  } else {
    initProductSection();
  }

  document.addEventListener('shopify:section:load', initProductSection);
{% endjavascript %}
