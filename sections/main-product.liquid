{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
-%}

<div class="section color-{{ section.settings.color_scheme }}" style="--section-padding-block: {{ section.settings.padding_block }}px;">
  <div class="page-width">
    <div class="product">
      <div class="product__media" data-product-gallery>
        {%- if product.media.size > 0 -%}
          <div class="product__media-main media media--{{ section.settings.image_ratio }}">
            {%- for media in product.media -%}
              <div
                class="product__media-item{% if forloop.first %} is-active{% endif %}"
                data-media-id="{{ media.id }}"
              >
                {{
                  media
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'eager',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    widths: '400, 600, 800, 1000, 1400',
                    alt: media.alt
                }}
              </div>
            {%- endfor -%}
          </div>

          {%- if product.media.size > 1 -%}
            <div class="product__thumbnails">
              {%- for media in product.media -%}
                <button
                  type="button"
                  class="product__thumbnail media media--square{% if forloop.first %} is-active{% endif %}"
                  data-thumbnail-for="{{ media.id }}"
                  aria-label="{{ media.alt | default: product.title | escape }}"
                >
                  {{ media | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', alt: '' }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="media media--{{ section.settings.image_ratio }}">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="product__details" data-variant-root data-currency="{{ cart.currency.iso_code }}">
        <script type="application/json" data-variant-json>
          {{ product.variants | json }}
        </script>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <span class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</span>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title h1" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'price' -%}
              <div class="product__price" data-price-container {{ block.shopify_attributes }}>
                {% render 'price', product: product, variant: current_variant, large: true %}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="product__options" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-option" data-option-index="{{ forloop.index0 }}">
                      <legend class="variant-option__legend">
                        {{ option.name }}
                        <span class="variant-option__selected" data-option-selected>{{ option.selected_value }}</span>
                      </legend>
                      <div class="variant-option__values">
                        {%- for value in option.values -%}
                          <input
                            type="radio"
                            class="variant-option__input visually-hidden"
                            id="{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                            name="{{ section.id }}-option-{{ forloop.parentloop.index0 }}"
                            value="{{ value | escape }}"
                            data-option-input
                            {% if option.selected_value == value %}
                              checked
                            {% endif %}
                          >
                          <label
                            class="variant-option__label"
                            for="{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                          >
                            {{ value }}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, class: 'product-form' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

                  {%- if block.settings.show_quantity -%}
                    <div class="product__quantity">
                      <label class="field__label" for="Quantity-{{ section.id }}">
                        {{- 'products.product.quantity' | t -}}
                      </label>
                      <input
                        type="number"
                        id="Quantity-{{ section.id }}"
                        name="quantity"
                        class="field__input product__quantity-input"
                        value="1"
                        min="1"
                        step="1"
                      >
                    </div>
                  {%- endif -%}

                  <button
                    type="submit"
                    name="add"
                    class="button button--primary button--full product__add"
                    data-add-button
                    data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
                    data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
                    data-unavailable-label="{{ 'products.product.unavailable' | t | escape }}"
                    {% unless current_variant.available %}
                      disabled
                    {% endunless %}
                  >
                    <span data-add-button-text>
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>

                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'trust_badges' -%}
              <ul class="product__trust" {{ block.shopify_attributes }}>
                {%- if block.settings.badge_1 != blank -%}
                  <li>
                    {% render 'icon', name: block.settings.badge_1_icon, size: 18 %}
                    {{ block.settings.badge_1 }}
                  </li>
                {%- endif -%}
                {%- if block.settings.badge_2 != blank -%}
                  <li>
                    {% render 'icon', name: block.settings.badge_2_icon, size: 18 %}
                    {{ block.settings.badge_2 }}
                  </li>
                {%- endif -%}
                {%- if block.settings.badge_3 != blank -%}
                  <li>
                    {% render 'icon', name: block.settings.badge_3_icon, size: 18 %}
                    {{ block.settings.badge_3 }}
                  </li>
                {%- endif -%}
              </ul>

            {%- when 'accordion' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary class="accordion__summary">
                  {{ block.settings.heading }}
                  {% render 'icon', name: 'chevron-down', size: 20 %}
                </summary>
                <div class="accordion__content rte">
                  {%- if block.settings.content != blank -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                  {%- if block.settings.page != blank -%}
                    {{ block.settings.page.content }}
                  {%- endif -%}
                </div>
              </details>

            {%- when 'text' -%}
              <div class="product__text rte text-muted" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

