<div class="section color-{{ section.settings.color_scheme }}" style="--section-padding-block: {{ section.settings.padding_block }}px;">
  <div class="page-width">
    <div class="section-header">
      <h1 class="h1">{{ blog.title | escape }}</h1>
    </div>

    {%- paginate blog.articles by section.settings.posts_per_page -%}
      <div class="article-grid" style="--grid-columns: {{ section.settings.columns_desktop }};">
        {%- for article in blog.articles -%}
          <article class="article-card">
            <a href="{{ article.url }}" class="article-card__link">
              <div class="media media--landscape">
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 750px) 33vw, 100vw',
                      widths: '300, 500, 800',
                      alt: article.image.alt
                  }}
                {%- else -%}
                  {{ 'blog-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </a>

            <div class="article-card__info">
              {%- if section.settings.show_date -%}
                <span class="eyebrow">{{ article.published_at | date: '%d %B %Y' }}</span>
              {%- endif -%}

              <h2 class="h4">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h2>

              {%- if section.settings.show_excerpt -%}
                <p class="text-muted">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
              {%- endif -%}

              <span class="article-card__more">
                {{ 'blogs.article.read_more' | t }}
                {% render 'icon', name: 'arrow-right', size: 16 %}
              </span>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 1.5rem;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .article-card__link {
    display: block;
  }

  .article-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-card__info a {
    text-decoration: none;
  }

  .article-card__info p {
    margin: 0;
  }

  .article-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  @media screen and (min-width: 750px) {
    .article-grid {
      grid-template-columns: repeat(var(--grid-columns, 3), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Posts per page",
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 48
    }
  ]
}
{% endschema %}
