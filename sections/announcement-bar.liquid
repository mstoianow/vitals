<div class="announcement color-{{ section.settings.color_scheme }}">
  <div class="page-width announcement__inner">
    {%- for block in section.blocks -%}
      {%- if block.settings.text != blank -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="announcement__item" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </a>
        {%- else -%}
          <p class="announcement__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .announcement {
    background: var(--color-background-gradient);
    color: rgb(var(--color-text));
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  .announcement__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    min-height: 2.5rem;
    text-align: center;
  }

  .announcement__item {
    margin: 0;
    padding-block: 0.5rem;
  }

  .announcement__item:not(:first-child) {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .announcement__item:not(:first-child) {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "class": "shopify-section--announcement",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free UK delivery over £50"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
