<div class="section color-{{ section.settings.color_scheme }}" style="--section-padding-block: {{ section.settings.padding_block }}px;">
  <div class="page-width">
    <div class="rich-text rich-text--{{ section.settings.text_alignment }} rich-text--style-{{ section.settings.style }}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="rich-text__buttons">
          <a href="{{ section.settings.button_link }}" class="button button--primary">
            {{- section.settings.button_label -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .rich-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 62ch;
  }

  .rich-text--center {
    align-items: center;
    margin: 0 auto;
    text-align: center;
  }

  .rich-text__buttons {
    margin-top: 0.5rem;
  }

  .rich-text--style-quote {
    max-width: 52ch;
    padding-block: 2.5rem;
    border-top: 1px solid rgb(var(--color-text));
    border-bottom: 1px solid rgb(var(--color-text));
  }

  .rich-text--style-quote .rte {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-weight: var(--font-heading-weight-light, var(--font-heading-weight));
    font-size: clamp(1.6rem, 1.3rem + 1.4vw, 2.5rem);
    line-height: 1.25;
    letter-spacing: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Нашият стандарт"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Пълна прозрачност за дозата, произхода и тестовете. Ако не можем да ви покажем доказателствата, не го продаваме.</p>"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "quote", "label": "Quotation (italic serif, ruled)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
