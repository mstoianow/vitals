<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- liquid
      assign body_font = settings.type_body_font
      assign heading_font = settings.type_header_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      assign heading_font_bold = heading_font | font_modify: 'weight', 'bold'
      assign body_key = body_font.family | append: body_font.weight | append: body_font.style
      assign heading_key = heading_font.family | append: heading_font.weight | append: heading_font.style
    -%}

    {%- unless body_font.system? and heading_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- liquid
      assign locale_root = request.locale.iso_code | split: '-' | first
      assign cyrillic_locales = 'bg,ru,uk,be,mk,sr,kk,ky,mn,tg' | split: ','
    -%}
    {%- if cyrillic_locales contains locale_root and body_font.system? == false -%}
      {{ 'source-sans-3-cyrillic-upright.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {%- endif -%}

    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {%- unless heading_key == body_key -%}
        {{ heading_font | font_face: font_display: 'swap' }}
        {{ heading_font_bold | font_face: font_display: 'swap' }}
      {%- endunless -%}

      {%- liquid
        assign cyrillic_upright = 'source-sans-3-cyrillic-upright.woff2' | asset_url
        assign cyrillic_italic = 'source-sans-3-cyrillic-italic.woff2' | asset_url
        assign cyrillic_range = 'U+0400-052F, U+1C80-1C8F, U+2DE0-2DFF, U+A640-A69F, U+2116'
        assign heading_weight = heading_font.weight | times: 1
      -%}
      @font-face { font-family: "Source Sans 3 Cyrillic"; font-style: normal; font-weight: 400; font-display: swap; src: url("{{ cyrillic_upright }}") format("woff2"); unicode-range: {{ cyrillic_range }}; }
      @font-face { font-family: "Source Sans 3 Cyrillic"; font-style: normal; font-weight: 700; font-display: swap; src: url("{{ cyrillic_upright }}") format("woff2"); unicode-range: {{ cyrillic_range }}; }
      @font-face { font-family: "Source Sans 3 Cyrillic"; font-style: italic; font-weight: 400; font-display: swap; src: url("{{ cyrillic_italic }}") format("woff2"); unicode-range: {{ cyrillic_range }}; }
      @font-face { font-family: "Source Sans 3 Cyrillic"; font-style: italic; font-weight: 700; font-display: swap; src: url("{{ cyrillic_italic }}") format("woff2"); unicode-range: {{ cyrillic_range }}; }
      {%- unless heading_weight == 400 or heading_weight == 700 -%}
        @font-face { font-family: "Source Sans 3 Cyrillic"; font-style: normal; font-weight: {{ heading_weight }}; font-display: swap; src: url("{{ cyrillic_upright }}") format("woff2"); unicode-range: {{ cyrillic_range }}; }
      {%- endunless -%}
    </style>

    {% style %}
      {%- for scheme in settings.color_schemes -%}
        {%- if forloop.first -%}:root,{%- endif -%}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background.rgb }};
          --color-background-gradient: {% if scheme.settings.background_gradient != blank %}{{ scheme.settings.background_gradient }}{% else %}rgb({{ scheme.settings.background.rgb }}){% endif %};
          --color-text: {{ scheme.settings.text.rgb }};
          --color-button: {{ scheme.settings.button.rgb }};
          --color-button-text: {{ scheme.settings.button_label.rgb }};
          --color-secondary-button-text: {{ scheme.settings.secondary_button_label.rgb }};
          --color-border: {{ scheme.settings.border.rgb }};
          --color-accent: {{ scheme.settings.accent.rgb }};
          --color-shadow: {{ scheme.settings.shadow.rgb }};
        }
      {%- endfor -%}

      :root {
        --page-width: {{ settings.page_width }}px;
        --spacing-sections: {{ settings.spacing_sections }}px;

        {%- if body_font.system? -%}
        --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        {%- else -%}
        --font-body-family: "{{ body_font.family }}", "Source Sans 3 Cyrillic", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, {{ body_font.fallback_families }};
        {%- endif %}
        --font-body-style: {{ settings.type_body_font.style }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 900 }};

        {%- if heading_font.system? -%}
        --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        {%- else -%}
        --font-heading-family: "{{ heading_font.family }}", "Source Sans 3 Cyrillic", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, {{ heading_font.fallback_families }};
        {%- endif %}
        --font-heading-style: {{ settings.type_header_font.style }};
        --font-heading-weight: {{ settings.type_header_font.weight }};
        --font-heading-transform: {{ settings.heading_transform }};

        --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

        --radius-button: {{ settings.radius_button }}px;
        --radius-input: {{ settings.radius_input }}px;
        --radius-card: {{ settings.radius_card }}px;
      }

      body {
        background: var(--color-background-gradient);
        color: rgb(var(--color-text));
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
