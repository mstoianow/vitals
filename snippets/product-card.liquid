{% doc %}
  Renders a product card for use in grids and carousels.

  @param {object} product - The product to render
  @param {boolean} [show_vendor] - Overrides the theme setting for the vendor line
  @param {boolean} [show_quick_add] - Overrides the theme setting for the quick add button
  @param {string} [image_ratio] - 'square', 'portrait' or 'natural'. Defaults to the theme setting.
  @param {boolean} [eager] - Loads the image eagerly. Use for the first row of a grid.

  Shows the product's Roman numeral (metafield custom.numeral, e.g. "I") above the title
  when set, in place of the vendor line.

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{%- liquid
  assign ratio = image_ratio | default: settings.card_image_ratio
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif

  assign vendor_visible = settings.card_show_vendor
  if show_vendor != nil
    assign vendor_visible = show_vendor
  endif

  assign quick_add_visible = settings.card_show_quick_add
  if show_quick_add != nil
    assign quick_add_visible = show_quick_add
  endif

  assign second_image = product.media[1].preview_image
  assign numeral = product.metafields.custom.numeral | strip | remove: '°'
-%}

<div class="product-card">
  <div class="product-card__media media media--{{ ratio }}">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag:
          loading: loading,
          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
          widths: '200, 300, 400, 600, 800',
          alt: product.featured_media.alt
      }}
      {%- if settings.card_show_second_image and second_image -%}
        {{
          second_image
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            class: 'product-card__image--hover',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
            widths: '200, 300, 400, 600, 800',
            alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    <div class="product-card__badges">
      {%- if product.available == false -%}
        <span class="badge badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
      {%- endif -%}
    </div>
  </div>

  <div class="product-card__info">
    {%- if numeral != blank -%}
      <span class="numeral product-card__numeral">°{{ numeral }}</span>
    {%- elsif vendor_visible and product.vendor != blank -%}
      <span class="product-card__vendor text-muted">{{ product.vendor }}</span>
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    {% render 'price', product: product, show_from: true %}

    {%- if quick_add_visible -%}
      {%- if product.available == false -%}
        <button type="button" class="button button--secondary button--full product-card__quick-add" disabled>
          {{- 'products.product.sold_out' | t -}}
        </button>
      {%- elsif product.variants.size == 1 -%}
        {%- form 'product', product, class: 'product-card__quick-add' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="button button--secondary button--full">
            {{- 'products.product.quick_add' | t -}}
          </button>
        {%- endform -%}
      {%- else -%}
        <a href="{{ product.url }}" class="button button--secondary button--full product-card__quick-add">
          {{- 'products.product.view_details' | t -}}
        </a>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
