{% doc %}
  Renders an inline SVG icon from the theme icon set.

  @param {string} name - The icon name, for example 'cart', 'search', 'leaf'
  @param {number} [size] - Width and height in pixels. Defaults to 20.

  @example
  {% render 'icon', name: 'cart' %}
  {% render 'icon', name: 'shield-check', size: 28 %}
{% enddoc %}

{%- liquid
  assign icon_size = size | default: 20
-%}

<svg
  class="icon icon--{{ name }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'cart' -%}
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
      <path d="M3 6h18" />
      <path d="M16 10a4 4 0 0 1-8 0" />
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="8" />
      <path d="m21 21-4.3-4.3" />
    {%- when 'menu' -%}
      <path d="M4 6h16" />
      <path d="M4 12h16" />
      <path d="M4 18h16" />
    {%- when 'close' -%}
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6" />
    {%- when 'chevron-left' -%}
      <path d="m15 18-6-6 6-6" />
    {%- when 'chevron-right' -%}
      <path d="m9 18 6-6-6-6" />
    {%- when 'plus' -%}
      <path d="M5 12h14" />
      <path d="M12 5v14" />
    {%- when 'minus' -%}
      <path d="M5 12h14" />
    {%- when 'user' -%}
      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
      <circle cx="12" cy="7" r="4" />
    {%- when 'check' -%}
      <path d="M20 6 9 17l-5-5" />
    {%- when 'arrow-right' -%}
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    {%- when 'star' -%}
      <path
        d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z"
        fill="currentColor"
        stroke="none"
      />
    {%- when 'leaf' -%}
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
      <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
    {%- when 'shield-check' -%}
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z" />
      <path d="m9 12 2 2 4-4" />
    {%- when 'truck' -%}
      <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" />
      <path d="M15 18H9" />
      <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14" />
      <circle cx="17" cy="18" r="2" />
      <circle cx="7" cy="18" r="2" />
    {%- when 'beaker' -%}
      <path d="M4.5 3h15" />
      <path d="M6 3v16a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V3" />
      <path d="M6 14h12" />
    {%- when 'recycle' -%}
      <path d="M7 19H4.8a2 2 0 0 1-1.7-3l1.6-2.6" />
      <path d="m9.3 5.5 1.2-2a2 2 0 0 1 3.4 0l1.7 2.9" />
      <path d="M17 14.5 19.2 18a2 2 0 0 1-1.7 3H15" />
      <path d="m5 12 2.5-4.3" />
      <path d="M14 21l2-2-2-2" />
      <path d="M8 8 5.5 12H10" />
      <path d="m19 12-2.5-4.3L14.5 11" />
    {%- when 'pause' -%}
      <rect x="6" y="4" width="4" height="16" rx="1" />
      <rect x="14" y="4" width="4" height="16" rx="1" />
    {%- when 'play' -%}
      <path d="m7 4 12 8-12 8Z" fill="currentColor" stroke="none" />
    {%- when 'instagram' -%}
      <rect width="20" height="20" x="2" y="2" rx="5" />
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z" />
      <path d="M17.5 6.5h.01" />
    {%- when 'tiktok' -%}
      <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" />
    {%- when 'facebook' -%}
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3Z" />
    {%- when 'youtube' -%}
      <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17" />
      <path d="m10 15 5-3-5-3Z" />
  {%- endcase -%}
</svg>
